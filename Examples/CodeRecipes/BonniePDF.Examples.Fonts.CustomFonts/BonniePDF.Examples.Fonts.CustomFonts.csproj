<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\BonniePDF\BonniePDF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google Noto fonts (OFL 1.1) shared by the example projects, copied to
         fonts/ in the output so the example embeds real TTFs from disk on any
         platform. These are example-only assets - they are NOT part of the
         published BonniePDF library/NuGet package. -->
    <None Include="..\..\assets\fonts\NotoSans-Regular.ttf" Link="fonts\NotoSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\NotoSansMath-Regular.ttf" Link="fonts\NotoSansMath-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\NotoSansSymbols2-Regular.ttf" Link="fonts\NotoSansSymbols2-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <Version>2026.10.22</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
