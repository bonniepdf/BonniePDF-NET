  <Target Name="VerifyChartSources" BeforeTargets="CoreCompile">
    <GetFileHash Files="@(ChartSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_HashedChartSources" />
    </GetFileHash>
    <Error Condition="'%(_HashedChartSources.FileHash)' != '%(_HashedChartSources.ExpectedHash)'" Text="Modified chart source: %(_HashedChartSources.Identity). Regenerate from its authoritative source." />
  </Target>
</Project>
