<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>2026.10.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1861;CA1859;MA0089</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BonniePDF\BonniePDF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="image.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared Document Definition conformance fixtures, generated from the specification. -->
    <None Include="Definition\Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Api\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Security\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
