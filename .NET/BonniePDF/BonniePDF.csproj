<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BonniePDF</RootNamespace>
    <AssemblyName>BonniePDF</AssemblyName>
    <Description>BonniePDF is a high-performance, zero-dependency PDF generation engine for .NET. Engineered for speed and compliance, it features an intuitive Fluent API for building complex documents, reports, integrated charting, and native PDF/A support.</Description>
    <Version>2026.04.1</Version>
    <Authors>BonniePDF</Authors>
    
    <RepositoryUrl></RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;generation;charting;report</PackageTags>
    <PackageIcon>BonniePDF.png</PackageIcon>
    <PackageReadmeFile></PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>BonniePDF</Title>
    <PackageProjectUrl>https://bonniepdf.dev</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BonniePDF.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BonniePDF.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
