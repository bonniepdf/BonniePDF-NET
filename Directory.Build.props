<Project>
  <PropertyGroup>
    <!-- Version is managed by scripts/Update-Versions.ps1 and scripts/update-versions.sh -->
    <!-- Format: [yyyy].[mm].[patch] (e.g., 2026.04.0) -->
    <Version>2026.11.13</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.339">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
